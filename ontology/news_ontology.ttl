@prefix core: <http://www.bbc.co.uk/ontologies/coreconcepts/> .
@prefix news: <http://example.org/news#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

news: a owl:Ontology ;
    rdfs:label "UK Parliamentary and Policy Event Ontology" ;
    rdfs:comment "A CQ-driven ontology for UK parliamentary and government policy events reported in UK news. The ontology models events, actors, institutions, policy topics, reporting artefacts, and lightweight provenance through source records." .

news:GovernmentSourceRecord a owl:Class ;
    rdfs:label "Government Source Record" ;
    rdfs:comment "A source record derived from a government source." ;
    rdfs:subClassOf news:OfficialSourceRecord .

news:ParliamentSourceRecord a owl:Class ;
    rdfs:label "Parliament Source Record" ;
    rdfs:comment "A source record derived from a parliamentary source." ;
    rdfs:subClassOf news:OfficialSourceRecord .

news:ParliamentaryDebate a owl:Class ;
    rdfs:label "Parliamentary Debate" ;
    rdfs:comment "A parliamentary event in which one or more policy topics are debated." ;
    rdfs:subClassOf news:ParliamentaryEvent .

news:articleURL a owl:DatatypeProperty ;
    rdfs:label "article URL" ;
    rdfs:comment "The canonical URL of a news article." ;
    rdfs:domain news:NewsArticle ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf schema:url .

news:concernsPolicyTopic a owl:ObjectProperty ;
    rdfs:label "concerns policy topic" ;
    rdfs:comment "Links a policy event to the policy topic it concerns." ;
    rdfs:domain news:PolicyEvent ;
    rdfs:range news:PolicyTopic ;
    rdfs:subPropertyOf schema:about .

news:hasAuthor a owl:ObjectProperty ;
    rdfs:label "has author" ;
    rdfs:comment "Links a news article to the journalist who authored it." ;
    rdfs:domain news:NewsArticle ;
    rdfs:range news:Journalist ;
    rdfs:subPropertyOf schema:author .

news:involvesActor a owl:ObjectProperty ;
    rdfs:label "involves actor" ;
    rdfs:comment "Links a policy event to a political actor involved in it." ;
    rdfs:domain news:PolicyEvent ;
    rdfs:range news:PoliticalActor .

news:issuedByDepartment a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "issued by department" ;
    rdfs:comment "Links a ministerial statement to the government department that issued it." ;
    rdfs:domain news:MinisterialStatement ;
    rdfs:range news:GovernmentDepartment ;
    rdfs:subPropertyOf news:involvesGovernmentBody .

news:matchedToSourceRecord a owl:ObjectProperty ;
    rdfs:label "matched to source record" ;
    rdfs:comment "Links a policy event to a source record aligned to it across datasets for integration purposes, without asserting strict identity between records." ;
    rdfs:domain news:PolicyEvent ;
    rdfs:range news:SourceRecord .

news:memberOfParty a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "member of party" ;
    rdfs:comment "Links a political actor to the political party they belong to." ;
    rdfs:domain news:PoliticalActor ;
    rdfs:range news:PoliticalParty ;
    rdfs:subPropertyOf schema:memberOf .

news:occursInLocation a owl:ObjectProperty ;
    rdfs:label "occurs in location" ;
    rdfs:comment "Links a policy event to the location in which it occurs." ;
    rdfs:domain news:PolicyEvent ;
    rdfs:range news:Location ;
    rdfs:subPropertyOf core:eventPlace .

news:occursInParliamentaryBody a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "occurs in parliamentary body" ;
    rdfs:comment "Links a parliamentary event to the parliamentary body in which it occurs." ;
    rdfs:domain news:ParliamentaryEvent ;
    rdfs:range news:ParliamentaryBody .

news:occursOnDate a owl:DatatypeProperty ;
    rdfs:label "occurs on date" ;
    rdfs:comment "The calendar date on which a policy event occurs." ;
    rdfs:domain news:PolicyEvent ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf core:startDate .

news:publishedBy a owl:ObjectProperty ;
    rdfs:label "published by" ;
    rdfs:comment "Links a news article to the news organisation that published it." ;
    rdfs:domain news:NewsArticle ;
    rdfs:range news:NewsOrganisation ;
    rdfs:subPropertyOf schema:publisher .

news:publishedDate a owl:DatatypeProperty ;
    rdfs:label "published date" ;
    rdfs:comment "The publication timestamp of a news article." ;
    rdfs:domain news:NewsArticle ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf schema:datePublished .

news:reportsOn a owl:ObjectProperty ;
    rdfs:label "reports on" ;
    rdfs:domain news:NewsArticle ;
    rdfs:range news:PolicyEvent ;
    owl:inverseOf news:reportedByArticle .

news:representedInOfficialSource a owl:ObjectProperty ;
    rdfs:label "represented in official source" ;
    rdfs:comment "Links a policy event to an official source record that directly describes or evidences that event." ;
    rdfs:domain news:PolicyEvent ;
    rdfs:range news:OfficialSourceRecord .

news:sourceIdentifier a owl:DatatypeProperty ;
    rdfs:label "source identifier" ;
    rdfs:comment "An identifier assigned to a source record by its source system." ;
    rdfs:domain news:SourceRecord ;
    rdfs:range xsd:string .

news:sourceSystem a owl:DatatypeProperty ;
    rdfs:label "source system" ;
    rdfs:comment "The name of the source system from which a source record was collected." ;
    rdfs:domain news:SourceRecord ;
    rdfs:range xsd:string .

news:sourceTitle a owl:DatatypeProperty ;
    rdfs:label "source title" ;
    rdfs:comment "The title or headline held by a source record." ;
    rdfs:domain news:SourceRecord ;
    rdfs:range xsd:string .

news:GovernmentDepartment a owl:Class ;
    rdfs:label "Government Department" ;
    rdfs:comment "A government department involved in a government policy event or issuing a ministerial statement." ;
    rdfs:subClassOf news:GovernmentBody .

news:GovernmentPolicyEvent a owl:Class ;
    rdfs:label "Government Policy Event" ;
    rdfs:comment "A policy event issued by or involving a government body or department." ;
    rdfs:subClassOf news:PolicyEvent .

news:Journalist a owl:Class ;
    rdfs:label "Journalist" ;
    rdfs:comment "A journalist who authors a news article reporting on a policy event." ;
    rdfs:subClassOf schema:Person .

news:Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment "A location in which a policy event occurs." ;
    rdfs:subClassOf core:Place .

news:MinisterialStatement a owl:Class ;
    rdfs:label "Ministerial Statement" ;
    rdfs:comment "A government policy event in which a department issues an official ministerial statement." ;
    rdfs:subClassOf news:GovernmentPolicyEvent .

news:NewsOrganisation a owl:Class ;
    rdfs:label "News Organisation" ;
    rdfs:comment "A news publisher reporting on policy events." ;
    rdfs:subClassOf schema:Organization .

news:ParliamentaryBody a owl:Class ;
    rdfs:label "Parliamentary Body" ;
    rdfs:comment "A parliamentary chamber, committee, or institution in which a parliamentary event occurs." ;
    rdfs:subClassOf news:GovernmentBody .

news:PolicyTopic a owl:Class ;
    rdfs:label "Policy Topic" ;
    rdfs:comment "A policy topic such as immigration, healthcare, taxation, or public spending." ;
    rdfs:subClassOf schema:Thing .

news:PoliticalParty a owl:Class ;
    rdfs:label "Political Party" ;
    rdfs:comment "A political party linked to political actors participating in policy events." ;
    rdfs:subClassOf schema:Organization .

news:involvesGovernmentBody a owl:ObjectProperty ;
    rdfs:label "involves government body" ;
    rdfs:comment "Links a policy event to a government body involved in it." ;
    rdfs:domain news:PolicyEvent ;
    rdfs:range news:GovernmentBody .

news:reportedByArticle a owl:ObjectProperty ;
    rdfs:label "reported by article" ;
    rdfs:comment "Links a policy event to a news article that reports on it." ;
    rdfs:domain news:PolicyEvent ;
    rdfs:range news:NewsArticle .

news:ParliamentaryEvent a owl:Class ;
    rdfs:label "Parliamentary Event" ;
    rdfs:comment "A policy event taking place within a parliamentary setting or linked to a parliamentary body." ;
    rdfs:subClassOf news:PolicyEvent .

news:PoliticalActor a owl:Class ;
    rdfs:label "Political Actor" ;
    rdfs:comment "A person participating in a policy event in a political capacity." ;
    rdfs:subClassOf schema:Person .

news:GovernmentBody a owl:Class ;
    rdfs:label "Government Body" ;
    rdfs:comment "An official public body relevant to the domain, including executive government departments and parliamentary institutions." ;
    rdfs:subClassOf schema:Organization .

news:OfficialSourceRecord a owl:Class ;
    rdfs:label "Official Source Record" ;
    rdfs:comment "A source record from an official parliamentary or government source." ;
    rdfs:subClassOf news:SourceRecord .

news:SourceRecord a owl:Class ;
    rdfs:label "Source Record" ;
    rdfs:comment "A source-side record used to construct or align the knowledge graph." ;
    rdfs:subClassOf schema:CreativeWork .

news:NewsArticle a owl:Class ;
    rdfs:label "News Article" ;
    rdfs:comment "A news article that reports on a policy event." ;
    rdfs:subClassOf schema:NewsArticle .

news:PolicyEvent a owl:Class ;
    rdfs:label "Policy Event" ;
    rdfs:comment "A real-world event concerning UK government policy or parliamentary policy activity." ;
    rdfs:subClassOf core:Event .

