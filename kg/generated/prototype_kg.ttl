@prefix core: <http://www.bbc.co.uk/ontologies/coreconcepts/> .
@prefix news: <http://example.org/news#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

news:BreakingNewsArticle a rdfs:Class ;
    rdfs:label "Breaking News Article" ;
    rdfs:comment "An article published as breaking news." ;
    rdfs:subClassOf news:NewsArticle .

news:Journalist a rdfs:Class ;
    rdfs:label "Journalist" ;
    rdfs:comment "A person who writes or reports news articles." ;
    rdfs:subClassOf schema:Person .

news:Location a rdfs:Class ;
    rdfs:label "Location" ;
    rdfs:comment "A geographic location mentioned in news." ;
    rdfs:subClassOf core:Place .

news:NaturalDisasterEvent a rdfs:Class ;
    rdfs:label "Natural Disaster Event" ;
    rdfs:comment "An earthquake, flood, wildfire, or similar event." ;
    rdfs:subClassOf news:NewsEvent .

news:NewsArticle a rdfs:Class ;
    rdfs:label "News Article" ;
    rdfs:comment "A news article from any source in our knowledge graph." ;
    rdfs:subClassOf schema:NewsArticle .

news:NewsEvent a rdfs:Class ;
    rdfs:label "News Event" ;
    rdfs:comment "A real-world event covered by news." ;
    rdfs:subClassOf core:Event .

news:NewsOrganisation a rdfs:Class ;
    rdfs:label "News Organisation" ;
    rdfs:comment "A media company or news publisher." ;
    rdfs:subClassOf news:Organisation .

news:OpinionArticle a rdfs:Class ;
    rdfs:label "Opinion Article" ;
    rdfs:comment "An editorial or opinion piece." ;
    rdfs:subClassOf news:NewsArticle .

news:Organisation a rdfs:Class ;
    rdfs:label "Organisation" ;
    rdfs:comment "An organisation mentioned in current news coverage." ;
    rdfs:subClassOf schema:Organization .

news:PoliticalEvent a rdfs:Class ;
    rdfs:label "Political Event" ;
    rdfs:comment "An election, debate, or policy announcement." ;
    rdfs:subClassOf news:NewsEvent .

news:Sentiment a rdfs:Class ;
    rdfs:label "Sentiment" ;
    rdfs:comment "Positive, negative, or neutral sentiment associated with a news article." .

news:Technology a rdfs:Class ;
    rdfs:label "Technology" ;
    rdfs:comment "A technology, platform, model, or technical capability mentioned in reporting." ;
    rdfs:subClassOf schema:Thing .

news:Topic a rdfs:Class ;
    rdfs:label "Topic" ;
    rdfs:comment "A thematic category or subject area." ;
    rdfs:subClassOf schema:Thing .

news: a owl:Ontology ;
    rdfs:label "Current News Ontology" ;
    rdfs:comment "An ontology for representing current news articles, events, journalists, organisations, and their relationships. Extends Schema.org and the BBC Core Concepts Ontology." .

news:Negative a news:Sentiment ;
    rdfs:label "Negative" .

news:Neutral a news:Sentiment ;
    rdfs:label "Neutral" .

news:Positive a news:Sentiment ;
    rdfs:label "Positive" .

news:announced a rdf:Property ;
    rdfs:label "announced" ;
    rdfs:comment "Links an organisation or person to something they announced." .

<http://example.org/news#article/32f4185c6418f40a> a news:NewsArticle,
        schema:NewsArticle ;
    news:articleURL "https://bbc.com/news/technology/robotics-ai-manufacturing"^^xsd:anyURI ;
    news:hasAuthor <http://example.org/news#person/John_Doe> ;
    news:mentionsLocation <http://example.org/news#location/Detroit> ;
    news:mentionsOrganisation <http://example.org/news#org/Automation_Systems_Inc> ;
    news:mentionsPerson <http://example.org/news#person/Automation_Systems>,
        <http://example.org/news#person/Automation_Transforming>,
        <http://example.org/news#person/Manufacturing_Industrial> ;
    news:mentionsTechnology <http://example.org/news#tech/AI>,
        <http://example.org/news#tech/Automation>,
        <http://example.org/news#tech/Machine_Learning>,
        <http://example.org/news#tech/Robotics> ;
    news:publishedBy <http://example.org/news#org/BBC_News> ;
    news:publishedDate "2024-01-15T12:30:00+00:00"^^xsd:dateTime ;
    schema:author <http://example.org/news#person/John_Doe> ;
    schema:datePublished "2024-01-15T12:30:00+00:00"^^xsd:dateTime ;
    schema:description "Industrial robotics powered by machine learning and AI are reshaping manufacturing in Detroit and across North America." ;
    schema:headline "Robotics and AI Automation Transforming Manufacturing" ;
    schema:mentions <http://example.org/news#location/Detroit>,
        <http://example.org/news#org/Automation_Systems_Inc>,
        <http://example.org/news#person/Automation_Systems>,
        <http://example.org/news#person/Automation_Transforming>,
        <http://example.org/news#person/Manufacturing_Industrial>,
        <http://example.org/news#tech/AI>,
        <http://example.org/news#tech/Automation>,
        <http://example.org/news#tech/Machine_Learning>,
        <http://example.org/news#tech/Robotics> ;
    schema:publisher <http://example.org/news#org/BBC_News> ;
    schema:url "https://bbc.com/news/technology/robotics-ai-manufacturing"^^xsd:anyURI .

<http://example.org/news#article/cc18f94e547b6ecc> a news:NewsArticle,
        schema:NewsArticle ;
    news:articleURL "https://techcrunch.com/2024/01/15/openai-gpt-breakthrough"^^xsd:anyURI ;
    news:hasAuthor <http://example.org/news#person/Jane_Smith> ;
    news:hasTopic <http://example.org/news#topic/research> ;
    news:mentionsLocation <http://example.org/news#location/San_Francisco> ;
    news:mentionsOrganisation <http://example.org/news#org/Machine_Learning_OpenAI_Corporation>,
        <http://example.org/news#org/OpenAI_Corporation> ;
    news:mentionsPerson <http://example.org/news#person/Machine_Learning>,
        <http://example.org/news#person/Model_Breakthrough>,
        <http://example.org/news#person/Sam_Altman> ;
    news:mentionsTechnology <http://example.org/news#tech/AI>,
        <http://example.org/news#tech/Artificial_Intelligence>,
        <http://example.org/news#tech/Deep_Learning>,
        <http://example.org/news#tech/GPT> ;
    news:publishedBy <http://example.org/news#org/TechCrunch> ;
    news:publishedDate "2024-01-15T10:00:00+00:00"^^xsd:dateTime ;
    schema:about <http://example.org/news#topic/research> ;
    schema:author <http://example.org/news#person/Jane_Smith> ;
    schema:datePublished "2024-01-15T10:00:00+00:00"^^xsd:dateTime ;
    schema:description "OpenAI Corporation has released a new GPT model demonstrating advances in artificial intelligence and deep learning, unveiled in San Francisco." ;
    schema:headline "OpenAI Announces GPT Model Breakthrough in Machine Learning" ;
    schema:mentions <http://example.org/news#location/San_Francisco>,
        <http://example.org/news#org/Machine_Learning_OpenAI_Corporation>,
        <http://example.org/news#org/OpenAI_Corporation>,
        <http://example.org/news#person/Machine_Learning>,
        <http://example.org/news#person/Model_Breakthrough>,
        <http://example.org/news#person/Sam_Altman>,
        <http://example.org/news#tech/AI>,
        <http://example.org/news#tech/Artificial_Intelligence>,
        <http://example.org/news#tech/Deep_Learning>,
        <http://example.org/news#tech/GPT> ;
    schema:publisher <http://example.org/news#org/TechCrunch> ;
    schema:url "https://techcrunch.com/2024/01/15/openai-gpt-breakthrough"^^xsd:anyURI .

news:articleURL a rdf:Property ;
    rdfs:label "article URL" ;
    rdfs:comment "The canonical URL of a news article." ;
    rdfs:domain news:NewsArticle ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf schema:url .

news:coversEvent a rdf:Property ;
    rdfs:label "covers event" ;
    rdfs:comment "Links a news article to the event it covers." ;
    rdfs:domain news:NewsArticle ;
    rdfs:range news:NewsEvent ;
    rdfs:subPropertyOf core:notablyAssociatedWith .

news:developedBy a rdf:Property ;
    rdfs:label "developed by" ;
    rdfs:comment "Links a technology or artefact to its developer." ;
    rdfs:domain news:Technology ;
    rdfs:range news:Organisation ;
    rdfs:subPropertyOf schema:creator .

news:eventDate a rdf:Property ;
    rdfs:label "event date" ;
    rdfs:comment "The date on which a news event occurred." ;
    rdfs:domain news:NewsEvent ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf core:startDate .

news:eventLocation a rdf:Property ;
    rdfs:label "event location" ;
    rdfs:comment "Links a news event to the place where it happened." ;
    rdfs:domain news:NewsEvent ;
    rdfs:range news:Location ;
    rdfs:subPropertyOf core:eventPlace .

news:hasAuthor a rdf:Property ;
    rdfs:label "has author" ;
    rdfs:comment "Links an article to the journalist credited with writing it." ;
    rdfs:domain news:NewsArticle ;
    rdfs:range news:Journalist ;
    rdfs:subPropertyOf schema:author .

news:hasFollowUp a rdf:Property ;
    rdfs:label "has follow-up" ;
    rdfs:comment "Links an article to a subsequent follow-up article." ;
    rdfs:domain news:NewsArticle ;
    rdfs:range news:NewsArticle .

news:hasSection a rdf:Property ;
    rdfs:label "has section" ;
    rdfs:comment "The editorial section assigned to an article." ;
    rdfs:domain news:NewsArticle ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf schema:articleSection .

news:hasSentiment a rdf:Property ;
    rdfs:label "has sentiment" ;
    rdfs:comment "Links an article to its sentiment classification." ;
    rdfs:domain news:NewsArticle ;
    rdfs:range news:Sentiment .

news:hasTopic a rdf:Property ;
    rdfs:label "has topic" ;
    rdfs:comment "Links an article to a thematic topic discussed in it." ;
    rdfs:domain news:NewsArticle ;
    rdfs:range news:Topic ;
    rdfs:subPropertyOf schema:about .

news:hasUpdateTimestamp a rdf:Property ;
    rdfs:label "update timestamp" ;
    rdfs:comment "The timestamp of the latest update known for an article." ;
    rdfs:domain news:NewsArticle ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf schema:dateModified .

news:involvedIn a rdf:Property ;
    rdfs:label "involved in" ;
    rdfs:comment "Links an entity to an event it is involved in." ;
    rdfs:subPropertyOf core:notablyAssociatedWith .

news:locatedIn a rdf:Property ;
    rdfs:label "located in" ;
    rdfs:comment "Links an entity or event to a location." ;
    rdfs:domain schema:Thing ;
    rdfs:range news:Location .

<http://example.org/news#location/Machine_Learning> a news:Location,
        core:Place ;
    schema:name "Machine Learning" .

news:mentionsLocation a rdf:Property ;
    rdfs:label "mentions location" ;
    rdfs:comment "Links an article to a location mentioned in its content." ;
    rdfs:domain news:NewsArticle ;
    rdfs:range news:Location ;
    rdfs:subPropertyOf schema:mentions .

news:mentionsOrganisation a rdf:Property ;
    rdfs:label "mentions organisation" ;
    rdfs:comment "Links an article to an organisation mentioned in its content." ;
    rdfs:domain news:NewsArticle ;
    rdfs:range news:Organisation ;
    rdfs:subPropertyOf schema:mentions .

news:mentionsPerson a rdf:Property ;
    rdfs:label "mentions person" ;
    rdfs:comment "Links an article to a person mentioned in its content." ;
    rdfs:domain news:NewsArticle ;
    rdfs:range schema:Person ;
    rdfs:subPropertyOf schema:mentions .

news:mentionsTechnology a rdf:Property ;
    rdfs:label "mentions technology" ;
    rdfs:comment "Links an article to a technology mentioned in its content." ;
    rdfs:domain news:NewsArticle ;
    rdfs:range news:Technology ;
    rdfs:subPropertyOf schema:mentions .

news:partOf a rdf:Property ;
    rdfs:label "part of" ;
    rdfs:comment "Links a thing to a larger thing it is part of." ;
    rdfs:subPropertyOf schema:isPartOf .

news:publishedBy a rdf:Property ;
    rdfs:label "published by" ;
    rdfs:comment "Links an article to the news organisation that published it." ;
    rdfs:domain news:NewsArticle ;
    rdfs:range news:NewsOrganisation ;
    rdfs:subPropertyOf schema:publisher .

news:publishedDate a rdf:Property ;
    rdfs:label "published date" ;
    rdfs:comment "The publication date of a news article." ;
    rdfs:domain news:NewsArticle ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf schema:datePublished .

news:usesTechnology a rdf:Property ;
    rdfs:label "uses technology" ;
    rdfs:comment "Links an organisation to a technology it is reported as using." ;
    rdfs:domain news:Organisation ;
    rdfs:range news:Technology .

news:wordCount a rdf:Property ;
    rdfs:label "word count" ;
    rdfs:comment "The number of words available for an article representation." ;
    rdfs:domain news:NewsArticle ;
    rdfs:range xsd:integer .

news:worksFor a rdf:Property ;
    rdfs:label "works for" ;
    rdfs:comment "Links a journalist to the news organisation they work for." ;
    rdfs:domain news:Journalist ;
    rdfs:range news:NewsOrganisation ;
    rdfs:subPropertyOf schema:worksFor .

<http://example.org/news#location/Detroit> a news:Location,
        core:Place ;
    schema:name "Detroit" .

<http://example.org/news#location/San_Francisco> a news:Location,
        core:Place ;
    schema:name "San Francisco" .

<http://example.org/news#org/Automation_Systems_Inc> a news:Organisation,
        schema:Organization ;
    news:usesTechnology <http://example.org/news#tech/AI>,
        <http://example.org/news#tech/Automation>,
        <http://example.org/news#tech/Machine_Learning>,
        <http://example.org/news#tech/Robotics> ;
    schema:name "Automation Systems Inc" .

<http://example.org/news#org/BBC_News> a news:NewsOrganisation,
        news:Organisation,
        schema:Organization ;
    schema:name "BBC News" .

<http://example.org/news#org/Machine_Learning_OpenAI_Corporation> a news:Organisation,
        schema:Organization ;
    news:usesTechnology <http://example.org/news#person/Machine_Learning>,
        <http://example.org/news#tech/AI>,
        <http://example.org/news#tech/Artificial_Intelligence>,
        <http://example.org/news#tech/Deep_Learning>,
        <http://example.org/news#tech/GPT> ;
    schema:name "Machine Learning OpenAI Corporation" .

<http://example.org/news#org/OpenAI_Corporation> a news:Organisation,
        schema:Organization ;
    news:usesTechnology <http://example.org/news#person/Machine_Learning>,
        <http://example.org/news#tech/AI>,
        <http://example.org/news#tech/Artificial_Intelligence>,
        <http://example.org/news#tech/Deep_Learning>,
        <http://example.org/news#tech/GPT> ;
    schema:name "OpenAI Corporation" .

<http://example.org/news#org/TechCrunch> a news:NewsOrganisation,
        news:Organisation,
        schema:Organization ;
    schema:name "TechCrunch" .

<http://example.org/news#person/Automation_Systems> a schema:Person ;
    schema:name "Automation Systems" .

<http://example.org/news#person/Automation_Transforming> a schema:Person ;
    schema:name "Automation Transforming" .

<http://example.org/news#person/Jane_Smith> a news:Journalist,
        schema:Person ;
    schema:name "Jane Smith" .

<http://example.org/news#person/John_Doe> a news:Journalist,
        schema:Person ;
    schema:name "John Doe" .

<http://example.org/news#person/Manufacturing_Industrial> a schema:Person ;
    schema:name "Manufacturing Industrial" .

<http://example.org/news#person/Model_Breakthrough> a schema:Person ;
    schema:name "Model Breakthrough" .

<http://example.org/news#person/Sam_Altman> a schema:Person ;
    schema:name "Sam Altman" .

<http://example.org/news#topic/research> a news:Topic,
        schema:Thing ;
    schema:name "research" .

<http://example.org/news#tech/Automation> a news:Technology,
        schema:Thing ;
    schema:name "Automation" .

<http://example.org/news#tech/Machine_Learning> a news:Technology,
        schema:Thing ;
    schema:name "Machine Learning" .

<http://example.org/news#tech/Robotics> a news:Technology,
        schema:Thing ;
    schema:name "Robotics" .

<http://example.org/news#person/Machine_Learning> a schema:Person ;
    schema:name "Machine Learning" .

<http://example.org/news#tech/Artificial_Intelligence> a news:Technology,
        schema:Thing ;
    schema:name "Artificial Intelligence" .

<http://example.org/news#tech/Deep_Learning> a news:Technology,
        schema:Thing ;
    schema:name "Deep Learning" .

<http://example.org/news#tech/GPT> a news:Technology,
        schema:Thing ;
    schema:name "GPT" .

<http://example.org/news#tech/AI> a news:Technology,
        schema:Thing ;
    schema:name "AI" .

